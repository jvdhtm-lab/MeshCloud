# MeshCloud local development environment.
# Copy to .env and adjust as needed. Docker Compose reads this file.

# PostgreSQL
POSTGRES_USER=mesh
POSTGRES_PASSWORD=mesh_dev_password
POSTGRES_DB=meshcloud

# Control plane
MESH_BIND_ADDR=0.0.0.0:8080
MESH_DATABASE_URL=postgres://mesh:mesh_dev_password@mesh-postgres:5432/meshcloud
MESH_DATABASE_MAX_CONNECTIONS=10
MESH_HEARTBEAT_INTERVAL_SECONDS=15
MESH_NODE_OFFLINE_AFTER_SECONDS=60
MESH_JOB_LEASE_SECONDS=60
MESH_JOB_SWEEP_INTERVAL_SECONDS=10
# MESH_REWARD_POLICY_VERSION=1
# MESH_REWARD_RATE_PER_UNIT=1
# MESH_DELEGATOR_REWARD_RATE_PER_UNIT=1
MESH_SETTLEMENT_BACKEND=local
MESH_SETTLEMENT_CHAIN_ID=31337
MESH_SETTLEMENT_BATCH_SIZE=100
MESH_SETTLEMENT_INTERVAL_SECONDS=10
# Per-agent message metering.
MESH_AGENT_MESSAGE_RATE_PER_SECOND=10
MESH_AGENT_MESSAGE_BURST=20
MESH_AGENT_MESSAGE_BYTES_PER_SECOND=100000
MESH_AGENT_MESSAGE_BYTES_BURST=200000
# MESH_PARTICIPANT_QUOTA_CREDITS=0
MESH_REPLICA_ROLE=primary
# MESH_NETWORK_LISTEN=/ip4/127.0.0.1/tcp/4010
MESH_NETWORK_TOPIC=meshcloud/nodes
MESH_LOG__LEVEL=info
MESH_LOG__FORMAT=pretty

# Worker (override per container)
MESH_CONTROL_PLANE_URL=http://mesh-control-plane:8080
MESH_WORKER_IDENTITY_PATH=/var/lib/meshcloud/node.key
MESH_STORAGE_GB=50
MESH_AVAILABILITY=when_idle
# Number of AI agents this worker hosts.
MESH_AGENT_COUNT=0
# libp2p mesh (disabled unless set).
# MESH_NETWORK_LISTEN=/ip4/127.0.0.1/tcp/4011
# MESH_NETWORK_BOOTSTRAP=/ip4/127.0.0.1/tcp/4010/p2p/<peer-id>
MESH_NETWORK_TOPIC=meshcloud/nodes
# MESH_SUPPORTED_WORKLOADS=echo
